# Maintainer: Daniel Sierra <soydanielsierradev@users.noreply.github.com>
#
# AUR package for Bruce (prebuilt binary). This file is the source of truth; to
# publish it, push it to the AUR git repo `bruce-bin`. Bump pkgver and sha256sums
# on every release.
pkgname=bruce-bin
pkgver=0.9.0
pkgrel=1
pkgdesc="Terminal workspace for Claude Code"
arch=('x86_64')
url="https://github.com/soydanielsierradev/bruce-tui"
license=('MIT')
provides=('bruce')
conflicts=('bruce')
# Bruce launches the Claude CLI at runtime; claude-code isn't in the official
# repos, so it's noted here rather than as a hard dependency.
optdepends=('claude-code: the Claude CLI Bruce runs inside its workspace')
source=("$pkgname-$pkgver.tar.gz::https://github.com/soydanielsierradev/bruce-tui/releases/download/v$pkgver/bruce-x86_64-unknown-linux-gnu.tar.gz")
sha256sums=('cba858045d6b3409d5aabc4ff63bee4290ee664113a7ea2f1a871c8f78e44e00')

package() {
  install -Dm755 "$srcdir/bruce" "$pkgdir/usr/bin/bruce"
}
