# Force LF line endings in the repository, regardless of the host OS.
# Without this, files committed from a Windows checkout land in the repo with
# CRLF and any later edit from Linux/macOS turns into a giant whitespace-only
# diff (see the v0.16.0 release for an example we'd rather not repeat).
* text=auto eol=lf

# Lockfiles and other generated bytes — leave to git's default detection.
Cargo.lock text eol=lf

# Binary-ish artefacts we don't want git to touch as text at all.
*.png binary
*.jpg binary
*.ico binary
*.zip binary
*.tar.gz binary
